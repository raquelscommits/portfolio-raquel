+
+  /* Enlace de texto con subrayado propio */
+  .text-link {
+    @apply inline-flex min-h-[3rem] items-center font-medium text-ink underline decoration-accent decoration-2 underline-offset-[6px] transition-colors hover:text-accent-deep;
