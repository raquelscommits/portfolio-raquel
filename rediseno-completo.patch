+  }
+
+  .project-link {
+    @apply transition-colors group-hover:text-accent;
+  }
+
+  .project-row:has(.project-link:focus-visible) {
+    @apply outline outline-2 outline-offset-4 outline-accent;
+  }
+
+  .project-link:focus-visible {
+    outline: none;
+  }
+
+  .project-arrow {
+    @apply transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:text-accent;
