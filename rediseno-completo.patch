+
+  .key-sm {
+    @apply px-2.5 py-1 text-xs;
+  }
+
+  .key:hover {
+    @apply translate-y-px;
+    border-bottom-width: 2px;
+    margin-bottom: 1px;
+  }
+
+  /* Contacto */
