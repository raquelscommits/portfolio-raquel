+
+@layer base {
+  html {
+    -webkit-text-size-adjust: 100%;
+  }
+
+  /* Desplazamiento suave solo si la persona no ha pedido reducir el movimiento */
+  @media (prefers-reduced-motion: no-preference) {
+    html {
+      scroll-behavior: smooth;
+    }
+  }
+
+  body {
+    @apply bg-paper font-sans text-ink antialiased;
+    font-feature-settings: 'ss01';
+  }
+
+  ::selection {
+    @apply bg-blush text-ink;
+  }
+
+  /* Ajuste óptico de Fraunces: más contraste en los tamaños grandes */
+  .font-display {
+    font-optical-sizing: auto;
+  }
+
+  /* Evita que la barra fija tape el título de cada sección al navegar con anclas */
+  section[id] {
+    scroll-margin-top: 4rem;
+  }
+
+  /* Foco visible y consistente para teclado */
+  :focus-visible {
+    outline: 2px solid theme('colors.accent.DEFAULT');
+    outline-offset: 3px;
+    border-radius: 2px;
+  }
+
+  .bg-ink :focus-visible {
+    outline-color: theme('colors.accent.light');
